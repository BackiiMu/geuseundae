        "detail_icon": { "rect": [34, 328, 61, 56] },
        "detail_name": { "rect": [110, 326, 300, 24] },
        "detail_meta": { "rect": [110, 351, 300, 18] },
        "detail_effect": { "rect": [110, 372, 330, 64] },
        "btn_equip": { "rect": [470, 352, 72, 34] },
        "btn_destroy": { "rect": [548, 352, 72, 34] },
        "empty_hint": { "rect": [110, 360, 420, 28] }
      }
