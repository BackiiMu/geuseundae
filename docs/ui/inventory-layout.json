{
  "schema": "geuseundae.ui.layout/1",
  "id": "inventory",
  "note": "인벤토리 화면 구성 정의 시안. 좌표는 모두 디자인 픽셀이고 부모 왼쪽 위가 기준이다. 이미지는 9패치 부품과 아이콘만 쓰고 배치·크기·글씨·개수는 이 파일이 정한다. 화면 비율에 맞는 profile을 골라 patch를 덧씌운다. 아직 게임에는 연결하지 않았다.",
  "skins": {
    "panel": { "src": "godot/assets/ui/modular/panel-normal-v1.png", "slice": [28, 31, 28, 31], "shadow": [3, 3, 0.55] },
    "panelInner": { "extends": "panel", "tint": [0.56, 0.53, 0.5] },
    "panelRail": { "extends": "panel", "slice": [22, 25, 22, 25], "tint": [0.56, 0.53, 0.5] },
    "plaque": { "src": "godot/assets/ui/modular/plaque-v1.png", "stretch": true },
    "button": {
      "normal": "godot/assets/ui/modular/button-normal-v1.png",
      "hover": "godot/assets/ui/modular/button-hover-v1.png",
      "pressed": "godot/assets/ui/modular/button-pressed-v1.png",
      "slice": [40, 40, 40, 40],
      "drawWidth": 12
    },
    "slot": {
      "normal": "godot/assets/ui/modular/slot-normal-v1.png",
      "selected": "godot/assets/ui/modular/slot-selected-v1.png",
      "slice": [9, 9, 9, 9]
    }
  },
  "colors": {
    "dim": "rgba(5,9,13,0.78)",
    "title": "#2a1710",
    "plaqueText": "#28170f",
    "souls": "#d9c59a",
    "slotLabel": "#d8c39e",
    "itemName": "#f0dcae",
    "itemMeta": "#b99d72",
    "itemEffect": "#d8d1c2",
    "empty": "#bcae91",
    "button": "#e7dcc5"
  },
  "profiles": [
