    {
      "id": "portrait",
      "label": "세로 (폰 세로)",
      "design": [432, 768],
      "when": { "aspectMax": 1.0 },
      "patch": {
        "frame": { "rect": [6, 8, 420, 752] },
        "title_plaque": { "rect": [22, 24, 102, 27] },
        "title_label": { "rect": [22, 28, 102, 25] },
        "souls": { "rect": [150, 27, 140, 24] },
        "btn_close": { "rect": [334, 24, 76, 27] },
